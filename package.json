{
  "name": "medlembre",
  "version": "2.0.0",
  "private": true,
  "description": "MedLembre - lembrete de medicamentos com login, histórico, acessibilidade e app Android (Capacitor)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:mobile": "node scripts/build-mobile.js",
    "icones": "node scripts/gerar-icones.js",
    "sync": "npm run build:mobile && cap sync android",
    "android:open": "npm run sync && cap open android",
    "android:apk": "npm run sync && node scripts/gerar-apk.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camilasantos1989/MedHora.git"
  },
  "keywords": [
    "medicamentos",
    "lembretes",
    "capacitor",
    "android"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/camilasantos1989/MedHora/issues"
  },
  "homepage": "https://github.com/camilasantos1989/MedHora#readme",
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/status-bar": "^8.0.4",
    "dotenv": "^18.0.8",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0"
  }
}
