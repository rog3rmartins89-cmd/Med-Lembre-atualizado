{
  "appId": "br.com.medlembre.app",
  "appName": "MedLembre",
  "webDir": "build",
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "backgroundColor": "#eaf5f2"
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": ["google.com"]
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_medlembre",
      "iconColor": "#087E83"
    }
  }
}
